{
  "providers": {
    "volcengine-plan": {
      "baseUrl": "https://ark.cn-beijing.volces.com/api/coding/v3",
      "api": "openai-completions",
      "apiKey": "$VOLCENGINE_API_KEY",
      "authHeader": true,
      "models": [
        {
          "id": "ark-code-latest",
          "name": "Volcengine Coding Plan",
