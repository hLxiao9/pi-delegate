{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pi-worker.invalid/self-review.schema.json",
  "title": "Pi Worker Self-Review Report",
  "description": "Worker-generated self-review consumed by the parent agent to reduce token spend on full-diff review. The parent agent still owns the final verdict; this is a hint, not evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "diffSha256", "acceptanceEvidence", "findings", "uncertainCriteria", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$" },
    "diffSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acceptanceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "enum": ["met", "uncertain", "unmet"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file"],
              "properties": {
                "file": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "line": { "type": ["integer", "null"], "minimum": 1 },
                "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "file", "line", "problem", "requiredChange"],
        "properties": {
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "file": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "problem": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "requiredChange": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "uncertainCriteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
  }
}
