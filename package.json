{
  "name": "spotworkers",
  "version": "0.3.0",
  "description": "Outsource bounded coding tasks to cheap agent workers. Your main agent keeps architecture, verification and commit rights — and you stop burning your quota.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "spot": "./scripts/spot.mjs",
    "pi-worker": "./scripts/spot.mjs"
  },
  "files": [
    "scripts/",
    "lib/",
    "schemas/",
    "fixtures/",
    "references/",
    "agents/",
    "docs/",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:syntax": "node --check scripts/spot.mjs && node --check scripts/install-config.mjs && node --check scripts/codex-meter.mjs",
    "check": "npm run check:syntax && npm test",
    "serve": "node scripts/spot.mjs serve",
    "dashboard": "node scripts/spot.mjs dashboard",
    "postinstall": "node scripts/install-config.mjs"
  },
  "keywords": [
    "pi-package",
    "agent-workers",
    "subagent",
    "agent",
    "multi-agent",
    "delegate",
    "orchestration",
    "claude-code",
    "codex",
    "opencode",
    "kimi",
    "qoder",
    "codebuddy",
    "trae",
    "cursor",
    "cost-saving",
    "quota",
    "token-saving",
    "dashboard",
    "cli"
  ],
  "license": "AGPL-3.0-or-later",
  "pi": {
    "skills": [
      "./"
    ]
  },
  "homepage": "https://github.com/hLxiao9/spotworkers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hLxiao9/spotworkers.git"
  },
  "bugs": {
    "url": "https://github.com/hLxiao9/spotworkers/issues"
  }
}
