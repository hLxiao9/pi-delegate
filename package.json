{
  "name": "pi-delegate",
  "version": "0.1.0",
  "description": "Parent-agent-owned Pi implementation worker: delegate bounded code tasks to Pi CLI with isolation, verification, review, and a live monitoring dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-worker": "./scripts/pi-worker.mjs"
  },
  "files": [
    "scripts/",
    "lib/",
    "schemas/",
    "fixtures/",
    "references/",
    "agents/",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:syntax": "node --check scripts/pi-worker.mjs && node --check scripts/install-config.mjs && node --check scripts/codex-meter.mjs",
    "check": "npm run check:syntax && npm test",
    "serve": "node scripts/pi-worker.mjs serve",
    "dashboard": "node scripts/pi-worker.mjs dashboard",
    "postinstall": "node scripts/install-config.mjs"
  },
  "keywords": [
    "pi-cli",
    "agent",
    "delegate",
    "codex",
    "claude-code",
    "trae",
    "cursor",
    "automation",
    "monitoring",
    "dashboard",
    "worker"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/hLxiao9/pi-delegate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hLxiao9/pi-delegate.git"
  },
  "bugs": {
    "url": "https://github.com/hLxiao9/pi-delegate/issues"
  }
}
